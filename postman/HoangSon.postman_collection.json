{
  "info": {
    "name": "Hoang Son - Pets, Appointments, Staff Orders, Stats",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Authentication uses the jwt cookie saved by Postman. Run requests manually in folder order. IDs come from repository data exports; replace them if your database differs. Order updates and pet writes mutate data. Appointment status update is not implemented."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "petId",
      "value": "6ac3a6f12ca9e4d46d5fe830"
    },
    {
      "key": "serviceId",
      "value": "6ac3a6f02ca9e4d46d5fe762"
    },
    {
      "key": "orderId",
      "value": "6ac3a6f12ca9e4d46d5fe83a"
    },
    {
      "key": "staffPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Customer - pets and appointments",
      "item": [
        {
          "name": "Login john@example.com",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
