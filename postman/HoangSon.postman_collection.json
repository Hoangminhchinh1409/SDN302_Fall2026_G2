        {
          "name": "Create pet - saves createdPetId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Milo Postman\",\n  \"type\": \"Dog\",\n  \"breed\": \"Pug\",\n  \"age\": 2,\n  \"weight\": 7,\n  \"notes\": \"Postman test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('createdPetId', pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pet details - newly created pet",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pets/{{createdPetId}}"
